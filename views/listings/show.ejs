<% layout("/layouts/boilerplate") %>
    <div class="row">
        <div class="col-8 offset-2">
            <h3>Details:</h3>
        <div class="card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="wait....">
        <div class="card-body">
            <p class="card-text"><%=listing.title %><br>
            <%=listing.description %><br>
            <b>&#8377</b><%=listing.price %><br>
            <%=listing.location %><br>
            <%=listing.country %><br>
            </p>
            <div class="btns">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark"> Edit</a>
                <form method="post" action="/listings/<%= listing._id%>?_method=delete">
                    <button class="btn btn-dark ">Delete</button>
                </form>
            </div>
            <div class="col-8 offset-3">
                <h4>
                    Leave a review
                </h4>
                <form action="/listings/<%= listing._id%>/reviews"  method="post" novalidate class="needs-validation">
                     <div class="mb-3 mt-3">
                        <label for="rating" class="form-label">Rating</label >
                        <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="comment" class="form-label">Comment</label >
                        <textarea required cols="30" rows="6" id="comment" name="review[comment]" class="form-control"></textarea>
                        <div class="invalid-feedback">Please add comment for review</div>
                    </div>
                    <button class="btn btn-dark">Submit</button>
                </form>
           
            </div>


        </div>
           




        </div>
   
        </div>
    </div>
