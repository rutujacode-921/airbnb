<% layout("/layouts/boilerplate") %>
    <div class="row">
        <div class="col-8 offset-2">
            <h3><%=listing.title %></h3>
        <div class="card listing-card" >
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="wait....">
        <div class="card-body">
            <%=listing.description %><br>
            <b>&#8377</b><%=listing.price %><br>
            <%=listing.location %><br>
            <%=listing.country %><br>
            </p>
            <div class="btns">
                <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark"> Edit</a>
                <form method="post" action="/listings/<%= listing._id%>?_method=delete">
                    <button class="btn btn-dark ">Delete</button>
                </form>
            </div>
            <hr>
            <div class="col-8 ">
                <h4>
                    Leave a review
                </h4>
                <form action="/listings/<%= listing._id%>/reviews"  method="post" novalidate class="needs-validation">
                     <div class="mb-3 mt-3">
                        <label for="rating" class="form-label">Rating</label >
                        <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                    </div>
                    <div class="mb-3 mt-3">
                        <label for="comment" class="form-label">Comment</label >
                        <textarea required cols="30" rows="6" id="comment" name="review[comment]" class="form-control"></textarea>
                        <div class="invalid-feedback">Please add comment for review</div>
                    </div>
                    <button class="btn btn-dark">Submit</button>
                </form>
            </div>
        </div>
        </div>
        <hr>
        <h4><b>All Reviews</b></h4>
        <div class="row">
            <% for(review of listing.reviews) {%>
                <div class=" card col-5 ms-2 mb-3">
                    <div class="card-body">
                        <h5 class="card-title">Rutuja</h5>
                        <p class="card-text"><%= review.comment%></p>
                        <p class="card-text"><%= review.rating%> stars</p>
                    </div>
                    <form action="/listings/<%=listing._id %>/reviews/<%= review._id %>?_method=delete" 
                        class="mb-2" method="post">
                        <button class="btn btn-dark btn-sm">Delete</button>
                    </form>
                </div>
            <% } %>
        </div>
        </div>
    </div>   