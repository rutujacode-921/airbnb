<% layout("/layouts/boilerplate") %>

<body>
    <h3>All listings</h3>
    <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2" >
        <% for(let list of allListings){ %>
            <a href="/listings/<%= list._id %>" class="listing-link">
            <div class="card col" >
                <img src="<%= list.image.url %>" class="card-img-top" alt="..." style="height: 16rem;" >
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <p class="card-text">
                        <b><%=list.title %></b><br>
                        <b>&#8377</b><%=list.price %>/night
                    </p>
                </div>
            </div>
            </a>
        <% }%>
    </div>
    
</body>
