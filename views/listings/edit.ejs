<% layout("/layouts/boilerplate") %>

   <div class="col-8 offset-2">
    <h3>Edit here</h3>
    <form method="post" action="/listings/<%= listing._id %>?_method=PUT" class="needs-validation" novalidate>
    <div class="mb-3">
        <label for="title" class="form-label" >Title</label>
        <input type="text" value="<%= listing.title %>" class="form-control" id="title" placeholder="enter title"  name="title" required>
        <div class="invalid-feedback">
        Enter valid title
      </div>
    </div>
    <div class="mb-3">
        <label for="description" class="form-label" >Description</label>
        <textarea type="text"  class="form-control" id="description" placeholder="enter description"  name="description" required> <%= listing.description %></textarea>
        <div class="invalid-feedback">
        Please write a description.
      </div>
    </div>

    <div class="mb-3">
        <label for="img-url" class="form-label">URL</label>
        <input type="text" value="<%= listing.image.url %>" class="form-control" id="img-url" placeholder="enter image url/link"  name="image" required>
    </div>
    <div class="row">
    <div class="col-md-4">
    <label for="price" class="form-label">Price</label>
    <input type="number" value="<%= listing.price %>" class="form-control" id="price"  name="price" required>
    <div class="invalid-feedback">
        Enter valid price
      </div>
    </div>
    <div class="col-md-8">
        <label for="country" class="form-label">Country</label>
        <input type="text" value="<%= listing.country %>" placeholder="enter country" class="form-control" id="country" name="country" required>
        <div class="invalid-feedback">
        Please valid country name.
      </div>
    </div>
    </div>
    <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input type="text" value="<%= listing.location %>" class="form-control" id="location" placeholder="add location"  name="location" required>
        <div class="invalid-feedback">
        Please enter valid location.
      </div>
    </div>
    <br>
    <button class="btn btn-dark">Edit</button>
    
    </form>
  </div> 
  <script src="/js/script.js"></script>     
